# Server Environment Configuration
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/remote_voting_system
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRE=7d
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# =============================================================================
# SMS GATEWAY PROVIDER CONFIGURATION (Fast2SMS Smart OTP)
# =============================================================================
# Supported SMS_PROVIDER options: 'fast2sms' | 'twilio' | 'msg91' | 'mock'
SMS_PROVIDER=fast2sms

# --- Option A: Fast2SMS Smart OTP (Recommended for India) ---
# 1. Sign up at https://www.fast2sms.com and get your API authorization key
# 2. Go to Dev API -> Smart OTP / OTP Service in Fast2SMS dashboard to generate an OTP ID
FAST2SMS_API_KEY=your_fast2sms_api_key_here
FAST2SMS_OTP_ID=your_fast2sms_otp_id_here

# --- Option B: Twilio (Global SMS Gateway) ---
# Sign up at https://www.twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# --- Option C: MSG91 (Indian DLT Gateway) ---
# Sign up at https://msg91.com
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_SENDER_ID=EVOTET
MSG91_TEMPLATE_ID=your_dlt_template_id_here
